# ant-comp prosapia configuration (tracked in git, not secret)

# Edited by Jose to set up prosapia on vib HPC and Modal. See docs/configuration.md for the full reference.

# ═════════════════════════════════════════════════════════════════════════════
#  Modal
# ═════════════════════════════════════════════════════════════════════════════
# Modal execution is simple as it depends on images. Activation scripts and configuration are
# not needed as everything happens in the image. It requires little specific configuration.
# ── 1. Global Modal settings ──────────────────────────────────────────────
# Runs (campaign) live on this Modal Volume, mounted at /runs in the workstation
# (`sapia modal-shell`) and in every task container. Your run_dirs must be under it.
SAPIA_MODAL_RUNS_VOLUME="sapia-runs-toon"
# Workstation size
# SAPIA_MODAL_SHELL_CPU="0.25"
# SAPIA_MODAL_SHELL_MEMORY="1024"
#  ── 2. Tool specific activation settings ─────────────────────────────────────────────
# Here you can specify volumes for weights/databases/caches (defaults in each tool's modal_image.py):
SAPIA_MODAL_VOLUME_RFD3_CKPT="rfd3-checkpoints"
SAPIA_MODAL_VOLUME_BOLTZ_CACHE="boltz-cache"
# BindCraft2's AlphaFold parameters (~5.3 GB), downloaded on first campaign.
SAPIA_MODAL_VOLUME_BINDCRAFT_CACHE="bindcraft-cache"
# RPXdock's motif-score tables ("hscore"), mounted at /rpxdock_files — which is
# RPXdock's own --hscore_data_dir default. Populated by hand with three lowercase
# alias dirs, measured on the Volume: ilv_h (348 MiB, the tool default, built from
# helix pairs), ailv_h (1.30 GiB — both .txz and .txz.pickle; untested, do not use),
# afilmv_ehl (14.55 GiB = 5.31 GiB .txz + 9.24 GiB .pickle, SS-dependent, all SS
# types — THE ALIAS THIS CAMPAIGN USES: pass --hscore-files afilmv_ehl and --mem 64G
# on every run). afilmv_ehl was PICKLED 2026-10-02: tables load in 199 s instead of
# 618 s, output verified bit-identical. Never delete this Volume, and never remove
# only SOME of an alias's .pickle files — a partial set makes RPXdock silently ignore
# every .txz. See .claude/skills/rpxdock/SKILL.md for the alias decision.
SAPIA_MODAL_VOLUME_RPXDOCK_HSCORE="rpxdock-hscore"
# SAPIA_MODAL_VOLUME_COLABFOLD_DATA="sapia-colabfold-data"
SAPIA_MODAL_VOLUME_AF3_PARAMS="af3-weights"
#SAPIA_MODAL_VOLUME_AF3_DB="af3-database"

# ═════════════════════════════════════════════════════════════════════════════
#  vib HPC (SLURM)          full explanation: docs/vib.md
# ═════════════════════════════════════════════════════════════════════════════
# This one file has three readers, which is why the section is split:
#   section 1   scripts/vib.sh and the vib-worker, on THIS machine. Nothing else reads it.
#   sections 2-4   prosapia ON vib. `bash scripts/vib.sh sync` copies this file into the
#               workspace; the compute node's task prelude sources it from there.
# Absolute paths only below. Modal never reads any of it (sapia_activate is skipped there).

# ── 1. YOURS — the three values to edit ──────────────────────────────────────
# ssh alias for the login node (~/.ssh/config)
SAPIA_VIB_HOST="vib"
# Your workspace: an rsync'd copy of this repo with its own .venv and outputs/.
SAPIA_VIB_WORKSPACE="/data/groups/csb/anastassia.vorobieva/jlmorales/ant-comp-jose"
# SLURM account, passed as `sapia run -a`. Every job needs it; never guess a value.
SAPIA_VIB_ACCOUNT="anastassia_vorobieva"

# ── 2. LAB-WIDE — shared, read-only, not ours to edit ────────────────────────
# Activation scripts for the built-in tools. The software they activate (rfd3, ProteinMPNN,
# Boltz, ...) is installed on the cluster, not in this repo, so syncing the repo does NOT replace them.
SAPIA_VIB_SHARED_ACTIVATION="/data/groups/csb/anastassia.vorobieva/softwares/prosapia-activation"

# ── 3. CUSTOM TOOL ACTIVATION — SAPIA_ACTIVATE_<NAME> → script sourced before the tool runs ─
# They need nothing beyond the workspace venv, so they ship in this repo and sync with it (activation/vib/).
# All of the tools below use the same activation script, which just activates the workspace venv with gemmi and numpy.
SAPIA_ACTIVATE_MKCOMPLEX="${SAPIA_VIB_WORKSPACE}/activation/vib/prosapia_python.sh"
SAPIA_ACTIVATE_CHAINSEL="${SAPIA_VIB_WORKSPACE}/activation/vib/prosapia_python.sh"
SAPIA_ACTIVATE_RINGFIT="${SAPIA_VIB_WORKSPACE}/activation/vib/prosapia_python.sh"
SAPIA_ACTIVATE_IFACEGEOM="${SAPIA_VIB_WORKSPACE}/activation/vib/prosapia_python.sh"
SAPIA_ACTIVATE_DIMERFIT="${SAPIA_VIB_WORKSPACE}/activation/vib/prosapia_python.sh"
SAPIA_ACTIVATE_EPITOPE="${SAPIA_VIB_WORKSPACE}/activation/vib/prosapia_python.sh"
SAPIA_ACTIVATE_LINKPATH="${SAPIA_VIB_WORKSPACE}/activation/vib/prosapia_python.sh"

# Built-in tools: the lab's shared scripts, by absolute path (audited: none sources a sibling
# relatively or assumes a cwd).
SAPIA_ACTIVATE_RFDIFFUSION3="${SAPIA_VIB_SHARED_ACTIVATION}/rfdiffusion3.sh"
SAPIA_ACTIVATE_RFDIFFUSION="${SAPIA_VIB_SHARED_ACTIVATION}/rfdiffusion.sh"
SAPIA_ACTIVATE_PROTEINMPNN="${SAPIA_VIB_SHARED_ACTIVATION}/proteinmpnn.sh"
SAPIA_ACTIVATE_BOLTZ="${SAPIA_VIB_SHARED_ACTIVATION}/boltz.sh"
SAPIA_ACTIVATE_ALPHAFOLD3="${SAPIA_VIB_SHARED_ACTIVATION}/alphafold3.sh"
SAPIA_ACTIVATE_COLABFOLD="${SAPIA_VIB_SHARED_ACTIVATION}/colabfold.sh"
SAPIA_ACTIVATE_USALIGN="${SAPIA_VIB_SHARED_ACTIVATION}/usalign.sh"
SAPIA_ACTIVATE_SYMMDEF="${SAPIA_VIB_SHARED_ACTIVATION}/rosetta.sh"
SAPIA_ACTIVATE_ALIGN_SYMM_AXIS="${SAPIA_VIB_SHARED_ACTIVATION}/align_symm_axis.sh"
SAPIA_ACTIVATE_ATOMIUM="${SAPIA_VIB_SHARED_ACTIVATION}/atomium.sh"
SAPIA_ACTIVATE_ATOMIUMPH="${SAPIA_VIB_SHARED_ACTIVATION}/atomium.sh"

# Not ported — they need real software installed on the cluster, so no activation script yet.
# SAPIA_ACTIVATE_CMS="${SAPIA_VIB_WORKSPACE}/activation/vib/cms.sh"
# SAPIA_ACTIVATE_BINDCRAFT2="${SAPIA_VIB_SHARED_ACTIVATION}/bindcraft2.sh"

# ── 4. VALUES THE SHARED SCRIPTS MAY DEPEND ON ───────────────
# (RFD3_CKPT is deliberately not here: export it in the rfd3 activation script; Modal tasks receive this file.)
# CONDA_PREFIX="/mnt/modules/easybuild/software/Miniconda3/24.7.1-0"
